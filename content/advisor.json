  "groups": [
    {
      "id": "work",
      "question": "What's the main work the scaffold is for?",
      "ask": true,
      "options": [
        "facade",
        "reroof",
        "internal_high",
        "over_void",
        "short_duration"
      ]
    },
    {
      "id": "ground",
      "question": "Can the scaffold stand on the ground directly below the work?",
      "ask": true,
      "options": [
        "ground_ok",
        "no_ground",
        "over_void"
      ],
      "labels": {
        "ground_ok": "Yes - firm ground",
        "no_ground": "No - pavement/roof can't be used",
        "over_void": "Nothing below - road, water or void"
      },
      "ask_unless": [
        "internal_high",
        "short_duration",
        "over_void"
      ]
    },
    {
      "id": "public",
      "question": "Will the public be passing below or beside it?",
      "ask": true,
      "options": [
        "public_below",
        "private_site"
      ],
      "labels": {
        "public_below": "Yes - pavement or street",
        "private_site": "No - closed site"
      },
      "ask_unless": [
        "internal_high",
        "private_site"
      ],
      "exclusive": true
    },
    {
      "id": "weather",
      "question": "Does the building need to stay dry while you work (e.g. occupied, roof open)?",
      "ask": true,
      "ask_if": [
        "reroof"
      ],
      "options": [
        "weather"
      ],
      "labels": {
        "weather": "Yes - keep it dry"
      }
    },
    {
      "id": "height",
      "question": "Roughly how tall does it need to go?",
      "ask": true,
      "exclusive": true,
      "ask_unless": [
        "internal_high",
        "short_duration"
      ],
      "options": [
        "low",
        "mid",
        "high"
      ],
      "labels": {
        "low": "Under 10 m (1-3 storeys)",
        "mid": "10-30 m",
        "high": "Over 30 m"
      }
    },
    {
      "id": "shape",
      "question": "What's the building like?",
      "ask": true,
      "exclusive": true,
      "ask_if": [
        "facade",
        "reroof"
      ],
      "options": [
        "irregular",
        "repetitive"
      ],
      "labels": {
        "irregular": "Irregular / period / heritage",
        "repetitive": "Regular / modern"
      },
      "ask_unless": [
        "no_ground",
        "over_void",
        "internal_high",
        "short_duration"
      ]
    },
    {
      "id": "extras",
      "question": "Anything else?",
      "ask": false,
      "options": [
        "heavy_materials",
        "many_trades",
        "long_duration"
      ]
    }
  ]
}
